# .env file for backend/src
# DO NOT COMMIT THIS FILE TO GIT! Add it to .gitignore.

# Django Security
SECRET_KEY=-p3@1x6$l$mh^vf4c_2c0$=*mkjc3^40q42^4!&q!tfiqdze)8
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Django Settings Module (important for local development)
DJANGO_SETTINGS_MODULE=yourfit_api.settings.development

# Database Configuration (for local Docker setup - uncomment when setting up Docker)
# DB_NAME=yourfit_db
# DB_USER=yourfit_user
# DB_PASSWORD=yourfit_password
# DB_HOST=db # 'db' is the service name in docker-compose
# DB_PORT=5432

# AWS S3 Configuration (for production static/media files - uncomment when deploying)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=eu-west-3 # Example: Paris region

# Production Security Headers (uncomment and configure for production)
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# CORS Allowed Origins (for production - specify your frontend domains)
# CORS_ALLOWED_ORIGINS=https://yourfit.io,https://app.yourfit.io